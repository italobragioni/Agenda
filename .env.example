# =====================================================================
# Variáveis de ambiente do projeto Agenda
# Copie este arquivo para ".env.local" e preencha com os valores reais.
# NUNCA compartilhe o .env.local nem cole segredos no código.
# =====================================================================

# --- Públicas (podem aparecer no navegador) ---
# Encontradas no Supabase em: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública do site (usada para montar o link de agendamento).
# Em desenvolvimento use: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Secretas (SOMENTE no servidor, jamais expor no navegador) ---
# Encontrada no Supabase em: Project Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=

# --- Cakto (assinaturas) ---
# Segredo do webhook (gerado ao criar o webhook na Cakto). Usado para validar
# a assinatura (HMAC) das notificações. NUNCA exponha no navegador.
CAKTO_WEBHOOK_SECRET=
# IDs das OFERTAS (mensais) criadas na Cakto, uma por plano.
# Ex.: 32f9yzc  (aparece no link https://pay.cakto.com.br/<id-da-oferta>)
CAKTO_OFFER_BASIC=
CAKTO_OFFER_PREMIUM=
CAKTO_OFFER_EMPRESARIAL=

# --- Stripe (LEGADO — será removido após a verificação da Cakto) ---
# Mantido temporariamente; não é mais usado no fluxo de assinatura.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_EMPRESARIAL=
