# =====================================================================
# Variáveis de ambiente do projeto Agenda
# Copie este arquivo para ".env.local" e preencha com os valores reais.
# NUNCA compartilhe o .env.local nem cole segredos no código.
# =====================================================================

# --- Públicas (podem aparecer no navegador) ---
# Encontradas no Supabase em: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública do site (usada para montar o link de agendamento).
# Em desenvolvimento use: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Secretas (SOMENTE no servidor, jamais expor no navegador) ---
# Encontrada no Supabase em: Project Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (assinaturas) ---
# Dashboard do Stripe > Developers > API keys
STRIPE_SECRET_KEY=
# Stripe > Developers > Webhooks > (seu endpoint) > Signing secret
STRIPE_WEBHOOK_SECRET=
# IDs de preço criados no Stripe (Products) para cada plano
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PREMIUM=
